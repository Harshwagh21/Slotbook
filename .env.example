# Used by pnpm dev / migrate / seed outside Docker (start Postgres with: docker compose up -d db)
# If localhost:5432 is already taken, map another host port:
#   DB_PORT=5442 docker compose up -d db
#   DATABASE_URL=postgres://slotbook:slotbook@localhost:5442/slotbook
DATABASE_URL=postgres://slotbook:slotbook@localhost:5432/slotbook
DB_PORT=5432
